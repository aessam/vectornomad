---
import Layout from '../layouts/Layout.astro';
import { site } from '../../site.config.mjs';
const social = [
  ['Podcast', 'https://essamcafe.com'],
  ['YouTube', site.social.youtube],
  ['Medium', site.social.medium],
  ['LinkedIn', site.social.linkedin],
  ['Twitter', site.social.twitter],
].filter(([, u]) => u);
---

<Layout title="About" description="Ahmed Essam. Engineer by trade, curious about everything else.">
  <article class="about">
    <h1>About</h1>
    <p>
      Software is my trade. The rest is curiosity: philosophy and ethics, how language shapes thought, why things are
      built the way they are, and long conversations with people I don't fully agree with. That is what the podcast is
      for. The writing is where I think out loud.
    </p>
    <p lang="ar" dir="rtl" class="ar">
      البرمجة مهنتي. الباقي فضول: فلسفة وأخلاق، وكيف تصنع اللغة الفكر، ولماذا تُبنى الأشياء كما تُبنى، وحوارات طويلة مع
      ناس قد لا أتفق معهم. من أجل ذلك البودكاست. وأكتب لأفكر بصوت مسموع.
    </p>
    <ul class="social" aria-label="Elsewhere">
      {social.map(([label, url]) => <li><a href={url}>{label}</a></li>)}
    </ul>
  </article>
</Layout>

<style>
  .about { max-width: 680px; display: flex; flex-direction: column; gap: 28px; }
  h1 { font-size: 40px; }
  p { margin: 0; font-size: 21px; line-height: 1.6; }
  .ar { font-size: 23px; line-height: 1.9; }
  .social { list-style: none; padding: 0; margin: 8px 0 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .social a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 16px; border: 1px solid var(--line); background: var(--card); border-radius: 999px; text-decoration: none; font-size: 16px; }
  @media (max-width: 560px) { h1 { font-size: 32px; } p { font-size: 19px; } .ar { font-size: 21px; } }
</style>
