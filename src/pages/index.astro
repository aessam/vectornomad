---
import Layout from '../layouts/Layout.astro';
import SectionHead from '../components/SectionHead.astro';
import EpisodeCard from '../components/EpisodeCard.astro';
import VideoCard from '../components/VideoCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ArabicCard from '../components/ArabicCard.astro';
import LinkCard from '../components/LinkCard.astro';
import { episodes, videos, articles, arabic, links } from '../lib/content';
import { href } from '../lib/url';
import { site } from '../../site.config.mjs';

const n = site.hub;
const [eps, vids, arts, ars, lks] = await Promise.all([episodes(), videos(), articles(), arabic(), links()]);
const latest = eps[0];
---

<Layout title="Home">
  <section class="banner" aria-label="Intro and latest episode" style={`--strip-left:url(${href('/brand/side-left.svg')});--strip-right:url(${href('/brand/side-right.svg')})`}>
    <div class="intro">
      <h1>{site.tagline}</h1>
      <p class="lead">{site.intro}</p>
      <div class="actions">
        <a href={href('/podcast')} class="btn">Latest episode</a>
        <a href={href('/stream')} class="btn-ghost">Full stream</a>
      </div>
    </div>
    {latest && <EpisodeCard entry={latest} featured />}
  </section>

  {vids.length > 0 && (
    <section class="stack">
      <SectionHead title="Videos" to="/videos" linkText="All videos" />
      <div class="grid-3">
        {vids.slice(0, n.videos).map((v) => <VideoCard entry={v} />)}
      </div>
    </section>
  )}

  {(arts.length > 0 || ars.length > 0) && (
    <section class:list={ars.length > 0 && arts.length > 0 ? 'grid-2' : 'stack'}>
      {arts.length > 0 && (
        <div class="stack">
          <SectionHead title="Writing" to="/writing" linkText="All articles" />
          {arts.slice(0, n.articles).map((a) => <ArticleCard entry={a} layout="row" />)}
        </div>
      )}
      {ars.length > 0 && (
        <div class="stack" lang="ar" dir="rtl">
          <SectionHead title="بالعربي" to="/ar" linkText="كل المقالات" lang="ar" />
          {ars.slice(0, n.arabic).map((p, i) => <ArabicCard entry={p} featured={i === 0} />)}
        </div>
      )}
    </section>
  )}

  {lks.length > 0 && (
    <section class="stack">
      <SectionHead title="Links I like" to="/links" linkText="All links" />
      <div class="grid-3">
        {lks.slice(0, n.links).map((l) => <LinkCard entry={l} />)}
      </div>
    </section>
  )}
</Layout>

<style>
  /* Banner styles live in global.css (.banner) so the pattern can be reused. */
</style>
