---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { fmtDate } from '../../lib/format';
import { href } from '../../lib/url';

export async function getStaticPaths() {
  const posts = await getCollection('ar', (e) => !e.data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={post.data.title} lang="ar" description={post.data.summary}>
  <article class:list={['post', { 'has-hero': !!post.data.image }]}>
    {post.data.image ? (
      <header class="hero">
        <img src={post.data.image.startsWith('/') ? href(post.data.image) : post.data.image} alt="" />
        <div class="hero-text">
          <div class="meta">{fmtDate(post.data.date, 'ar')}</div>
          <h1>{post.data.title}</h1>
        </div>
      </header>
    ) : (
      <header class="plain">
        <div class="meta">{fmtDate(post.data.date, 'ar')}</div>
        <h1>{post.data.title}</h1>
      </header>
    )}
    <div class="body"><Content /></div>
  </article>
</Layout>

<style>
  .post { max-width: 760px; display: flex; flex-direction: column; gap: 20px; }
  .post.has-hero { max-width: 860px; background: var(--card); border-radius: var(--radius); box-shadow: var(--shadow); overflow: hidden; }
  .plain { display: flex; flex-direction: column; gap: 12px; }
  h1 { font-size: 40px; }
  /* Header image blends into the card: the bottom of the image fades out, the title sits in the faded zone. */
  .hero { position: relative; }
  .hero img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; display: block; -webkit-mask-image: linear-gradient(to bottom, #000 40%, transparent 100%); mask-image: linear-gradient(to bottom, #000 40%, transparent 100%); }
  .hero-text { position: absolute; inset-inline: 32px; bottom: 0; display: flex; flex-direction: column; gap: 8px; }
  .hero-text h1 { font-size: 44px; line-height: 1.35; text-shadow: 0 1px 0 var(--card); }
  .has-hero .body { padding: 8px 32px 36px; }
  .has-hero .hero-text .meta { color: var(--muted); }
  .body { font-size: 21px; line-height: 2; }
  /* Every block and list item picks its own direction from its first strong character,
     so an English paragraph inside an Arabic post reads left-to-right and sits left. */
  .body :global(> *), .body :global(li), .body :global(code) { unicode-bidi: plaintext; text-align: start; }
  .body :global(ul), .body :global(ol) { padding: 0; }
  .body :global(li) { list-style-position: inside; } /* marker follows the item's own direction */
  .body :global(p) { margin: 0 0 1.2em; }
  .body :global(img) { border-radius: 14px; margin: 0 0 1.2em; }
  .body :global(pre) { direction: ltr; text-align: left; font-family: var(--font-plex-mono); font-size: 15px; line-height: 1.6; background: var(--tint); border-radius: 12px; padding: 16px 20px; overflow-x: auto; margin: 0 0 1.2em; }
  .body :global(code) { font-family: var(--font-plex-mono); font-size: 0.85em; }
  .body :global(h2) { font-size: 28px; margin: 1.4em 0 0.6em; }
  .body :global(blockquote) { margin: 0 0 1.2em; padding-inline-start: 20px; border-inline-start: 3px solid var(--line); color: var(--muted); }
  @media (max-width: 560px) { h1 { font-size: 32px; } .hero-text h1 { font-size: 30px; } .hero-text { inset-inline: 20px; } .has-hero .body { padding: 8px 20px 28px; } .body { font-size: 19px; } }
</style>
