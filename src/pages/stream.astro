---
import Layout from '../layouts/Layout.astro';
import EpisodeCard from '../components/EpisodeCard.astro';
import VideoCard from '../components/VideoCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ArabicCard from '../components/ArabicCard.astro';
import LinkCard from '../components/LinkCard.astro';
import { stream } from '../lib/content';
const items = await stream();
---

<Layout title="Stream" description="Everything, newest first.">
  <h1>Everything, in order.</h1>
  <div class="list">
    {items.map((it) => {
      if (it.kind === 'episode') return <EpisodeCard entry={it.entry} />;
      if (it.kind === 'video') return <VideoCard entry={it.entry} />;
      if (it.kind === 'article') return <ArticleCard entry={it.entry} layout="row" />;
      if (it.kind === 'ar') return <ArabicCard entry={it.entry} featured />;
      return <LinkCard entry={it.entry} />;
    })}
  </div>
</Layout>

<style>
  h1 { font-size: 40px; }
  .list { max-width: 760px; display: flex; flex-direction: column; gap: 20px; }
</style>
