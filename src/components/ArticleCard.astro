---
import type { CollectionEntry } from 'astro:content';
import Card from './Card.astro';
import { fmtDate, langOf } from '../lib/format';
interface Props { entry: CollectionEntry<'articles'>; layout?: 'stack' | 'row' }
const { entry, layout = 'stack' } = Astro.props;
const d = entry.data;
---

<Card layout={layout} tone={d.image ? 'card' : 'tint'}>
  {d.image && <img slot="media" src={d.image} alt="" loading="lazy" style={layout === 'row' ? 'aspect-ratio: 1 / 1' : undefined} />}
  <Fragment slot="eyebrow">Medium · {fmtDate(d.date)}</Fragment>
  <h3 class="tile-title" lang={langOf(d.title)} dir="auto"><a href={d.url}>{d.title}</a></h3>
  {d.excerpt && <p class="tile-sub" lang={langOf(d.excerpt)} dir="auto">{d.excerpt}</p>}
</Card>
