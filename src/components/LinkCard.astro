---
import type { CollectionEntry } from 'astro:content';
import Card from './Card.astro';
import { fmtDate } from '../lib/format';
import { host, href } from '../lib/url';
interface Props { entry: CollectionEntry<'links'> }
const { entry } = Astro.props;
const d = entry.data;
const label = d.source ?? host(d.url);
const img = d.image ? (d.image.startsWith('/') ? href(d.image) : d.image) : undefined;
---

<Card tone={img ? 'card' : 'tint'}>
  {img && <img slot="media" src={img} alt="" loading="lazy" />}
  <Fragment slot="eyebrow">{d.kind === 'mine' ? 'Pick' : 'Link'} · {label} · {fmtDate(d.date)}</Fragment>
  <h3 class="tile-title"><a href={d.url}>{d.title}</a></h3>
  {d.note && <p class="tile-sub">{d.note}</p>}
</Card>
