---
// Shared tile. Every card on the site is one of these, so grids line up and hover feels the same.
// Slots: media (bleeds to the edge), eyebrow, default (title + text), footer (pinned to the bottom).
interface Props {
  tone?: 'card' | 'tint';   // tint = text-only tile on a navy-tinted fill
  layout?: 'stack' | 'row'; // row = media on the inline-start side, fixed width
  lang?: string;
  dir?: 'ltr' | 'rtl' | 'auto';
  class?: string;
}
const { tone = 'card', layout = 'stack', lang, dir, class: cls } = Astro.props;
const hasMedia = Astro.slots.has('media');
const hasEyebrow = Astro.slots.has('eyebrow');
const hasFooter = Astro.slots.has('footer');
---

<article class:list={['tile', tone, layout, cls]} lang={lang} dir={dir}>
  {hasMedia && <div class="tile-media"><slot name="media" /></div>}
  <div class="tile-body">
    {hasEyebrow && <div class="eyebrow"><slot name="eyebrow" /></div>}
    <slot />
    {hasFooter && <div class="tile-footer"><slot name="footer" /></div>}
  </div>
</article>
