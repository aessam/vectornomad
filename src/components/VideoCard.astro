---
import type { CollectionEntry } from 'astro:content';
import Card from './Card.astro';
import { fmtDate, langOf } from '../lib/format';
interface Props { entry: CollectionEntry<'videos'> }
const { entry } = Astro.props;
const d = entry.data;
---

<Card class="video">
  <button slot="media" type="button" class="yt-facade" data-video-id={d.videoId} aria-label={`Play: ${d.title}`}>
    {d.thumbnail && <img src={d.thumbnail} alt="" loading="lazy" />}
    <span class="play" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="26" height="26"><path d="M8 5v14l11-7z" fill="currentColor"></path></svg>
    </span>
  </button>
  <Fragment slot="eyebrow">Video · {fmtDate(d.date)}</Fragment>
  <h3 class="tile-title no-stretch" lang={langOf(d.title)} dir="auto"><a href={d.url}>{d.title}</a></h3>
</Card>

<script>
  // Facade: thumbnail only until clicked, then the real player. Keeps the page light and cookie-free.
  document.querySelectorAll<HTMLButtonElement>('.yt-facade').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.videoId;
      if (!id) return;
      const frame = document.createElement('iframe');
      frame.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1`;
      frame.title = btn.getAttribute('aria-label') ?? 'Video';
      frame.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      frame.allowFullscreen = true;
      frame.className = 'yt-frame';
      btn.replaceWith(frame);
    });
  });
</script>

<style>
  .yt-facade {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
    padding: 0;
    background: var(--dark);
    cursor: pointer;
    display: block;
  }
  .yt-facade img { width: 100%; height: 100%; object-fit: cover; }
  .play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 56px; height: 56px; border-radius: 50%;
    background: var(--play); color: #fff;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
  }
  :global(.yt-frame) { width: 100%; aspect-ratio: 16 / 9; border: 0; display: block; }
</style>
