---
import type { CollectionEntry } from 'astro:content';
import { fmtDate } from '../lib/format';
import { href } from '../lib/url';
interface Props { entry: CollectionEntry<'ar'>; featured?: boolean }
const { entry, featured = false } = Astro.props;
const d = entry.data;
---

<article lang="ar" dir="rtl" class:list={['ar', { soft: featured }]}>
  <div class="meta">{fmtDate(d.date, 'ar')}</div>
  <h3 class="card-title"><a href={href(`/ar/${entry.id}`)}>{d.title}</a></h3>
  {featured && d.summary && <p class="muted">{d.summary}</p>}
</article>

<style>
  .ar { display: flex; flex-direction: column; gap: 8px; }
  .card-title { font-size: 24px; font-weight: 700; }
  p { margin: 0; }
</style>
