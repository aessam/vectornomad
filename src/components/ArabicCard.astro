---
import type { CollectionEntry } from 'astro:content';
import Card from './Card.astro';
import { fmtDate } from '../lib/format';
import { href } from '../lib/url';
interface Props { entry: CollectionEntry<'ar'>; featured?: boolean }
const { entry, featured = false } = Astro.props;
const d = entry.data;
---

<Card tone="tint" lang="ar" dir="rtl">
  <Fragment slot="eyebrow">{fmtDate(d.date, 'ar')}</Fragment>
  <h3 class="tile-title ar"><a href={href(`/ar/${entry.id}`)}>{d.title}</a></h3>
  {featured && d.summary && <p class="tile-sub">{d.summary}</p>}
</Card>
