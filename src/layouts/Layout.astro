---
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../../site.config.mjs';
import type { Lang } from '../lib/format';
import { href } from '../lib/url';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
  ogImage?: string; // path under public/, generated by scripts/og-images.sh
  ogType?: 'website' | 'article';
}
const { title, description = site.intro, lang = 'en', ogImage = '/og/site.png', ogType = 'website' } = Astro.props;
const dir = lang === 'ar' ? 'rtl' : 'ltr';
const pageUrl = new URL(Astro.url.pathname, site.url).href;
const imageUrl = new URL(href(ogImage), site.url).href;
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {site.name}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={lang === 'ar' ? 'ar_EG' : 'en_US'} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="icon" href={href('/favicon.png')} type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />
    <meta name="theme-color" content="#184377" />
    <Font cssVariable="--font-amiri" preload />
    <Font cssVariable="--font-crimson" preload />
    <Font cssVariable="--font-plex-mono" />
  </head>
  <body>
    <Header />
    <main class="wrap stack-lg" style="padding-top: 48px; padding-bottom: 80px; flex: 1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
