---
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../../site.config.mjs';
import type { Lang } from '../lib/format';
import { href } from '../lib/url';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
}
const { title, description = site.intro, lang = 'en' } = Astro.props;
const dir = lang === 'ar' ? 'rtl' : 'ltr';
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {site.name}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={href('/favicon.png')} type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />
    <meta name="theme-color" content="#184377" />
    <Font cssVariable="--font-amiri" preload />
    <Font cssVariable="--font-crimson" preload />
    <Font cssVariable="--font-plex-mono" />
  </head>
  <body>
    <Header />
    <main class="wrap stack-lg" style="padding-top: 48px; padding-bottom: 80px; flex: 1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
